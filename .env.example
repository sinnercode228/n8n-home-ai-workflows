# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Placeholders only - no real values in this file.

# ---- versions (pin what you tested; upgrade deliberately, after a backup)
N8N_VERSION=2.40.6
OLLAMA_IMAGE_TAG=latest
QDRANT_IMAGE_TAG=latest

# ---- which optional services to run: ollama, qdrant, proxy
COMPOSE_PROFILES=ollama,qdrant

# ---- n8n core
# REQUIRED. Encrypts all saved credentials. Generate once:  openssl rand -hex 32
# Store a copy in the family password manager. If it is lost, every
# credential in n8n must be re-entered; if it leaks, rotate all API keys.
N8N_ENCRYPTION_KEY=

TIMEZONE=America/New_York
N8N_HOST=localhost
N8N_PROTOCOL=http
# The URL external services (meeting recorder, phone shortcut) use to reach webhooks.
N8N_PUBLIC_URL=http://localhost:5678/
# Keep true behind HTTPS. Set to false ONLY while using plain http://localhost.
N8N_SECURE_COOKIE=false

# ---- files
# Folder with documents for private Q&A (mounted read-only at /data/docs).
DOCS_DIR=./documents

# ---- local models (pulled by the ollama-models one-shot service)
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b

# ---- optional HTTPS proxy (profile: proxy)
N8N_DOMAIN=n8n.home.example
CADDY_BASIC_AUTH_USER=family
# bcrypt hash from `caddy hash-password`. Wrap in single quotes: it contains $ signs.
CADDY_BASIC_AUTH_HASH=''

# API keys (Anthropic, Notion, Telegram, Google) are NOT set here.
# They are entered once in the n8n UI under Credentials, where they are
# encrypted with N8N_ENCRYPTION_KEY. See README -> Credentials.
